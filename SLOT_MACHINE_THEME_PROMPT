## Usage Example
```jsx
import { SlotMachineTheme, SlotReel, SlotLever, ThemeToggle } from './components/slot';

function App() {
  return (
    <SlotMachineTheme 
      isScanning={isScanning}
      results={[{ status: 'pass' }, { status: 'warning' }, { status: 'pass' }]}
      onSpin={() => runScan()}
    >
      {/* Your content */}
    </SlotMachineTheme>
  );
}
```

